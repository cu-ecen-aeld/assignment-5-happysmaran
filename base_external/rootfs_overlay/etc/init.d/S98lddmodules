#!/bin/sh

case "$1" in
  start)
    echo "Loading LDD modules"
    # Use absolute paths to the modules built by Buildroot
    insmod /lib/modules/6.12.27/extra/scull.ko 2>/dev/null
    insmod /lib/modules/6.12.27/extra/faulty.ko 2>/dev/null
    insmod /lib/modules/6.12.27/extra/hello.ko 2>/dev/null

    # Create the scull device nodes
    scull_major=$(awk '$2=="scull" {print $1}' /proc/devices)
    if [ -n "$scull_major" ]; then
        mknod /dev/scull0 c $scull_major 0
        chmod 666 /dev/scull0
    fi

    # Create the faulty device node
    faulty_major=$(awk '$2=="faulty" {print $1}' /proc/devices)
    if [ -n "$faulty_major" ]; then
        mknod /dev/faulty c $faulty_major 0
        chmod 666 /dev/faulty
    fi
    ;;
  stop)
    echo "Unloading LDD modules"
    rmmod faulty 2>/dev/null
    rmmod scull 2>/dev/null
    rmmod hello 2>/dev/null
    rm -f /dev/scull0 /dev/faulty
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
esac

exit 0
